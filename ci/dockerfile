# Build stage base
FROM node:24.11.0-alpine AS base
LABEL maintainer="andrechristikan@gmail.com"
ARG NODE_ENV
ENV NODE_ENV=${NODE_ENV}
# pnpm version is pinned via the "packageManager" field in package.json
RUN corepack enable
WORKDIR /app

# Stage to install all dependencies and build the app
FROM base AS builder
COPY . .
RUN set -x && pnpm install --frozen-lockfile --prod=false --ignore-scripts
RUN pnpm db:generate
RUN pnpm --filter api build

# Main Stage
FROM base AS main
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/package.json
RUN set -x && pnpm install --frozen-lockfile --prod --ignore-scripts

# Copy only necessary files from previous stages
COPY --from=builder /app/apps/api/generated/prisma-client ./apps/api/generated/prisma-client
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Set working directory to apps/api for running the app
WORKDIR /app/apps/api

# Create non-root user for security
RUN addgroup -S ec2-user && adduser -S ec2-user -G ec2-user && \
    chown -R ec2-user:ec2-user /app
USER ec2-user

RUN touch .env
EXPOSE 3000

# Add healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/api/public/hello

CMD ["pnpm", "start:prod"]
