# Web marketing (Next.js + Drizzle → PostgreSQL)

# Bắt buộc. Local (pnpm dev trên macOS/Linux): trỏ tới Postgres của API (host cổng 5435).
DATABASE_URL=postgresql://postgres:postgres123@localhost:5435/vismarttech

# Tùy chọn — đăng nhập Clerk
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Tùy chọn — chống lạm dụng
# ARCJET_KEY=

# Tùy chọn — trỏ tới backend API
# NEXT_PUBLIC_API_URL=http://localhost:3000/api
# NEXT_PUBLIC_API_KEY=

# x-api-key gọi backend (server-side, dùng ở route auth). Mặc định = key dev trong Env.ts;
# production override bằng secret:
# API_KEY=
