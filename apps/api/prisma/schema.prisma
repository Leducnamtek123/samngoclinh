datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

model ApiKey {
  id       String @id @default(uuid())
  type     EnumApiKeyType @default(default)
  name     String
  key      String
  hash     String
  isActive Boolean        @default(true)
  startAt  DateTime?
  endAt    DateTime?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique(fields: [key])
  @@unique(fields: [hash])
  @@index(fields: [isActive, type, createdAt(sort: Desc)])
  @@index(fields: [name])
  @@map("ApiKeys")
}

model Role {
  id          String @id @default(uuid())
  name        String
  description String?
  type        EnumRoleType  @default(user)
  abilities   Json @default("[]")

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  users User[] @relation("UserRole")

  @@unique(fields: [name])
  @@index(fields: [type, createdAt(sort: Desc)])
  @@map("Roles")
}

model Country {
  id         String @id @default(uuid())
  name       String
  alpha2Code String
  alpha3Code String
  phoneCode  String[]
  continent  String
  timezone   String

  mobileNumbers UserMobileNumber[] @relation("UserMobileNumberCountry")
  users         User[]             @relation("UserCountry")

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique(fields: [alpha2Code])
  @@unique(fields: [alpha3Code])
  @@index(fields: [continent])
  @@index(fields: [name])
  @@map("Countries")
}

model UserMobileNumber {
  id         String @id @default(uuid())
  userId     String
  countryId  String
  phoneCode  String
  number     String
  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  country       Country        @relation("UserMobileNumberCountry", fields: [countryId], references: [id])
  user          User           @relation("UserMobileNumberUser", fields: [userId], references: [id])
  verifications Verification[] @relation("UserMobileNumberVerification")

  @@unique(fields: [countryId, phoneCode, number])
  @@index(fields: [userId, isVerified])
  @@map("UserMobiles")
}

model UserAddress {
  id        String    @id @default(uuid())
  userId    String
  label     String?
  recipient String?
  phone     String?
  detail    String
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?
  user      User      @relation("UserAddresses", fields: [userId], references: [id])

  @@index(fields: [userId, deletedAt])
  @@map("UserAddresses")
}


model User {
  id              String @id @default(uuid())
  name            String?
  username        String
  isVerified      Boolean            @default(false)
  verifiedAt      DateTime?
  email           String
  roleId          String
  password        String?
  passwordExpired DateTime?
  passwordCreated DateTime?
  passwordAttempt Int?
  signUpAt        DateTime           @default(now())
  signUpFrom      EnumUserSignUpFrom
  signUpWith      EnumUserSignUpWith
  status          EnumUserStatus     @default(active)
  gender          EnumUserGender?
  birthDate       DateTime?
  countryId       String
  lastLoginAt     DateTime?
  lastIPAddress   String?
  lastLoginFrom   EnumUserLoginFrom?
  lastLoginWith   EnumUserLoginWith?
  termPolicy      Json
  photo           Json?

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  mobileNumbers           UserMobileNumber[]         @relation("UserMobileNumberUser")
  addresses               UserAddress[]              @relation("UserAddresses")
  verifications           Verification[]             @relation("UserVerifications")
  passwordHistories       PasswordHistory[]          @relation("UserPasswordHistories")
  activityLogs            ActivityLog[]              @relation("UserActivityLogs")
  role                    Role                       @relation("UserRole", fields: [roleId], references: [id])
  country                 Country                    @relation("UserCountry", fields: [countryId], references: [id])
  sessions                Session[]                  @relation("UserSessions")
  acceptances             TermPolicyUserAcceptance[] @relation("TermPolicyUserAcceptanceUser")
  forgotPasswords         ForgotPassword[]           @relation("UserForgotPassword")
  twoFactor               TwoFactor?                 @relation("UserTwoFactor")
  notifications           Notification[]             @relation("UserNotifications")
  notificationSettings    NotificationUserSetting[]  @relation("UserNotificationSettings")
  deviceOwnerships        DeviceOwnership[]          @relation("DeviceOwnershipUser")
  revokedSessions         Session[]                  @relation("SessionRevokedByUser")
  revokedDeviceOwnerships DeviceOwnership[]          @relation("DeviceOwnershipRevokedByUser")
  gardens                 CultivationGarden[]        @relation("UserGardens")
  beds                    CultivationBed[]           @relation("UserBeds")
  trees                   CultivationTree[]          @relation("UserTrees")
  orders                  Order[]                    @relation("UserOrders")

  @@unique(fields: [username])
  @@unique(fields: [email])
  @@index(fields: [id, deletedAt])
  @@index(fields: [email, deletedAt])
  @@index(fields: [status, deletedAt, createdAt(sort: Desc)])
  @@index(fields: [roleId, status, deletedAt])
  @@index(fields: [countryId, status, signUpAt(sort: Desc)])
  @@map("Users")
}

model Verification {
  id             String @id @default(uuid())
  userId         String
  mobileNumberId String?
  to             String
  type           EnumVerificationType
  token          String
  expiredAt      DateTime
  verifiedAt     DateTime?
  isUsed         Boolean              @default(false)
  reference      String

  createdAt DateTime @default(now())
  createdBy String?

  user         User              @relation("UserVerifications", fields: [userId], references: [id])
  mobileNumber UserMobileNumber? @relation("UserMobileNumberVerification", fields: [mobileNumberId], references: [id])

  @@unique(fields: [reference])
  @@index(fields: [token, expiredAt, isUsed, type])
  @@index(fields: [userId, type, isUsed])
  @@map("Verifications")
}

model PasswordHistory {
  id        String @id @default(uuid())
  userId    String
  password  String
  type      EnumPasswordHistoryType
  expiredAt DateTime

  user User @relation("UserPasswordHistories", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?

  @@index(fields: [userId, expiredAt(sort: Desc)])
  @@map("PasswordHistories")
}

model ActivityLog {
  id          String @id @default(uuid())
  userId      String
  action      EnumActivityLogAction
  ipAddress   String?
  userAgent   Json
  description String
  geoLocation Json?
  metadata    Json?

  user User @relation("UserActivityLogs", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?

  @@index(fields: [userId, createdAt(sort: Desc)])
  @@index(fields: [userId, action, createdAt(sort: Desc)])
  @@map("ActivityLogs")
}

model Session {
  id                String @id @default(uuid())
  userId            String
  deviceOwnershipId String
  jti               String
  ipAddress         String?
  userAgent   Json
  geoLocation Json?
  expiredAt         DateTime
  revokedAt         DateTime?
  isRevoked         Boolean      @default(false)
  revokedById       String?

  revokedBy       User?           @relation("SessionRevokedByUser", fields: [revokedById], references: [id])
  user            User            @relation("UserSessions", fields: [userId], references: [id])
  deviceOwnership DeviceOwnership @relation("DeviceOwnershipSessions", fields: [deviceOwnershipId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique(fields: [userId, jti])
  @@index(fields: [userId, expiredAt(sort: Desc), isRevoked])
  @@index(fields: [isRevoked, expiredAt(sort: Asc)])
  @@index(fields: [userId, deviceOwnershipId, isRevoked])
  @@index(fields: [deviceOwnershipId])
  @@map("Sessions")
}

model Device {
  id                   String @id @default(uuid())
  fingerprint          String
  name                 String?
  platform             EnumDevicePlatform
  lastActiveAt         DateTime                        @default(now())
  notificationToken    String?
  notificationProvider EnumDeviceNotificationProvider?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  ownerships DeviceOwnership[] @relation("DeviceOwnershipDevice")

  @@unique(fields: [fingerprint])
  @@map("Devices")
}

model DeviceOwnership {
  id           String @id @default(uuid())
  deviceId     String
  userId       String
  revokedAt    DateTime?
  isRevoked    Boolean   @default(false)
  revokedById  String?
  lastActiveAt DateTime  @default(now())

  biometricEnabled   Boolean            @default(false)
  biometricToken     String?
  biometricType      EnumBiometricType?
  biometricEnabledAt DateTime?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  revokedBy User?     @relation("DeviceOwnershipRevokedByUser", fields: [revokedById], references: [id])
  device    Device    @relation("DeviceOwnershipDevice", fields: [deviceId], references: [id])
  user      User      @relation("DeviceOwnershipUser", fields: [userId], references: [id])
  sessions  Session[] @relation("DeviceOwnershipSessions")

  @@index(fields: [deviceId, revokedAt])
  @@index(fields: [userId, isRevoked])
  @@index(fields: [userId, revokedAt])
  @@index(fields: [deviceId, userId, revokedAt])
  @@map("DeviceOwnerships")
}

model TwoFactor {
  id            String @id @default(uuid())
  userId        String
  secret        String?
  iv            String?
  backupCodes   String[]  @default([])
  enabled       Boolean   @default(false)
  requiredSetup Boolean   @default(false)
  confirmedAt   DateTime?
  lastUsedAt    DateTime?
  attempt       Int       @default(0)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  user User @relation("UserTwoFactor", fields: [userId], references: [id])

  @@unique(fields: [userId])
  @@map("TwoFactors")
}

model TermPolicy {
  id          String @id @default(uuid())
  type        EnumTermPolicyType
  contents    Json @default("[]")
  version     Int                  @default(1)
  status      EnumTermPolicyStatus @default(draft)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  userAcceptances TermPolicyUserAcceptance[] @relation("TermPolicyUserAcceptanceTermPolicy")

  @@unique(fields: [type, version])
  @@index(fields: [type, status, publishedAt(sort: Desc)])
  @@map("TermPolicies")
}

model TermPolicyUserAcceptance {
  id           String @id @default(uuid())
  userId       String
  termPolicyId String
  acceptedAt   DateTime @default(now())

  user       User       @relation("TermPolicyUserAcceptanceUser", fields: [userId], references: [id])
  termPolicy TermPolicy @relation("TermPolicyUserAcceptanceTermPolicy", fields: [termPolicyId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?

  @@unique(fields: [userId, termPolicyId])
  @@index(fields: [termPolicyId, acceptedAt(sort: Desc)])
  @@map("TermPolicyUserAcceptances")
}

model FeatureFlag {
  id             String @id @default(uuid())
  key            String
  description    String
  isEnable       Boolean @default(true)
  rolloutPercent Int     @default(100)
  metadata       Json?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique(fields: [key])
  @@index(fields: [isEnable])
  @@map("FeatureFlags")
}

model ForgotPassword {
  id        String @id @default(uuid())
  userId    String
  to        String
  token     String
  expiredAt DateTime
  resetAt   DateTime?
  isUsed    Boolean   @default(false)
  reference String

  createdAt DateTime @default(now())
  createdBy String?

  user User @relation("UserForgotPassword", fields: [userId], references: [id])

  @@unique(fields: [reference])
  @@index(fields: [token, expiredAt, isUsed])
  @@map("ForgotPasswords")
}

model Notification {
  id       String @id @default(uuid())
  userId   String
  type     EnumNotificationType
  priority EnumNotificationPriority @default(normal)
  title    String
  body     String
  metadata Json?
  isRead   Boolean                  @default(false)
  readAt   DateTime?

  user       User                   @relation("UserNotifications", fields: [userId], references: [id])
  deliveries NotificationDelivery[] @relation("NotificationDeliveries")

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index(fields: [userId, isRead, createdAt(sort: Desc)])
  @@index(fields: [userId, type, createdAt(sort: Desc)])
  @@index(fields: [userId, priority, isRead, createdAt(sort: Desc)])
  @@map("Notifications")
}

model NotificationDelivery {
  id             String @id @default(uuid())
  notificationId String
  channel        EnumNotificationChannel
  sentAt         DateTime?
  processedAt    DateTime?
  failureTokens  String[]                @default([])

  notification Notification @relation("NotificationDeliveries", fields: [notificationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique(fields: [notificationId, channel])
  @@index(fields: [channel, createdAt(sort: Desc)])
  @@map("NotificationDeliveries")
}

model NotificationUserSetting {
  id       String @id @default(uuid())
  userId   String
  channel  EnumNotificationChannel
  type     EnumNotificationType
  isActive Boolean                 @default(true)

  user User @relation("UserNotificationSettings", fields: [userId], references: [id])

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique(fields: [userId, channel, type])
  @@index(fields: [userId, isActive])
  @@map("NotificationUserSettings")
}

model CatalogPlant {
  id          String @id @default(uuid())
  code        String
  name        String
  ageYear     Int
  price       Int
  stock       Int
  status      String
  orderCount  Int      @default(0)
  images      String[] @default([])
  description String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique(fields: [code])
  @@index(fields: [ageYear, status, price])
  @@map("CatalogPlants")
}

model CatalogProduct {
  id          String @id @default(uuid())
  code        String
  name        String
  category    String
  unit        String
  price       Int
  stock       Int
  status      String
  featured    Boolean  @default(false)
  images      String[] @default([])
  description String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique(fields: [code])
  @@index(fields: [category, status, featured])
  @@map("CatalogProducts")
}

model Cart {
  id        String @id @default(uuid())
  userId    String
  items     Json @default("[]")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique(fields: [userId])
  @@map("Carts")
}


model PromotionCampaign {
  id                String @id @default(uuid())
  code              String
  title             String
  description       String
  note              String?
  status            String
  remainingSlots    Int
  requiredVerified  Boolean  @default(false)
  requiredDeposit   Boolean  @default(false)
  plantCode         String?
  startAt           DateTime?
  endAt             DateTime?
  metadata          Json?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique(fields: [code])
  @@index(fields: [status, remainingSlots])
  @@map("PromotionCampaigns")
}

model ContentArticle {
  id          String @id @default(uuid())
  slug        String
  title       String
  category    String
  summary     String
  body        String?
  status      String
  sortOrder   Int      @default(0)
  publishedAt DateTime?
  coverImage  String?
  metadata    Json?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique(fields: [slug])
  @@index(fields: [category, status, publishedAt(sort: Desc)])
  @@map("ContentArticles")
}

model CultivationGarden {
  id            String    @id @default(uuid())
  code          String
  name          String
  ownerUserId   String?
  status        String
  totalBeds     Int       @default(0)
  activeBeds    Int       @default(0)
  totalTrees    Int       @default(0)
  metadata      Json?
  location      String?
  description   String?
  area          Float?
  images        String[]  @default([])
  latitude      Float?
  longitude     Float?
  managerName   String?
  managerPhone  String?
  establishedAt DateTime?
  maxBeds       Int       @default(0)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  ownerUser User?            @relation("UserGardens", fields: [ownerUserId], references: [id], onDelete: SetNull)
  beds      CultivationBed[] @relation("GardenBeds")

  @@unique(fields: [code])
  @@index(fields: [status, ownerUserId])
  @@map("CultivationGardens")
}

model CultivationBed {
  id               String    @id @default(uuid())
  code             String
  gardenCode       String
  name             String
  ageYear          Int
  treeCount        Int
  status           String
  ownerUserId      String?
  metadata         Json?
  maxTrees         Int       @default(0)
  width            Float?
  length           Float?
  soilType         String?
  lastFertilizedAt DateTime?
  lastWateredAt    DateTime?
  description      String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  garden    CultivationGarden @relation("GardenBeds", fields: [gardenCode], references: [code], onDelete: Cascade)
  ownerUser User?             @relation("UserBeds", fields: [ownerUserId], references: [id], onDelete: SetNull)
  trees     CultivationTree[] @relation("BedTrees")

  @@unique(fields: [code])
  @@index(fields: [gardenCode, status, ageYear])
  @@map("CultivationBeds")
}

model CultivationTree {
  id                         String    @id @default(uuid())
  code                       String
  bedCode                    String?
  ownerUserId                String?
  name                       String
  ageYear                    Int
  quantity                   Int
  status                     String
  carePackageCode            String?
  carePackageExpiredAt       DateTime?
  protectionPackageCode      String?
  protectionPackageExpiredAt DateTime?
  metadata                   Json?
  plantedAt                  DateTime?
  healthStatus               String    @default("healthy")
  lastCareDate               DateTime?
  nextCareDate               DateTime?
  expectedHarvestAt          DateTime?
  images                     String[]  @default([])
  priceBought                Int?      @default(0)

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  bed           CultivationBed? @relation("BedTrees", fields: [bedCode], references: [code], onDelete: SetNull)
  ownerUser     User?           @relation("UserTrees", fields: [ownerUserId], references: [id], onDelete: SetNull)
  contractItems EContractItem[] @relation("TreeContractItems")

  @@unique(fields: [code])
  @@index(fields: [status, ageYear, ownerUserId])
  @@map("CultivationTrees")
}

model CultivationBedLocation {
  id         String   @id @default(uuid())
  code       String   @unique
  bedCode    String
  row        Int
  col        Int
  status     String   @default("empty") // empty, planted, inactive
  treeCode   String?  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([bedCode, status])
  @@map("CultivationBedLocations")
}


model WalletAccount {
  id               String @id @default(uuid())
  userId           String
  balancePoint     Int      @default(0)
  treesOwned       Int      @default(0)
  transferEnabled  Boolean  @default(true)
  metadata         Json?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique(fields: [userId])
  @@index(fields: [balancePoint, treesOwned])
  @@map("WalletAccounts")
}

model WalletTransaction {
  id             String @id @default(uuid())
  code           String
  userId         String
  type           String
  title          String
  amount         Int
  balanceAfter   Int?
  status         String
  metadata       Json?
  occurredAt     DateTime @default(now())

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique(fields: [code])
  @@index(fields: [userId, occurredAt(sort: Desc)])
  @@map("WalletTransactions")
}

model Order {
  id             String @id @default(uuid())
  code           String
  userId         String
  status         String
  currency       String   @default("VND")
  subtotal       Int
  shippingFee    Int      @default(0)
  discount       Int      @default(0)
  total          Int
  paymentMethod  String?
  paymentStatus  String   @default("pending")
  deliveryType   String   @default("shipping")
  shippingAddress String?
  customerName   String?
  customerPhone  String?
  customerNote   String?
  items          Json
  paidAt         DateTime?
  cancelledAt    DateTime?
  metadata      Json?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  user       User?       @relation("UserOrders", fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[] @relation("OrderItems")
  contract   EContract?  @relation("OrderContract")

  @@unique(fields: [code])
  @@index(fields: [userId, status, createdAt(sort: Desc)])
  @@map("Orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String?
  productType String?  @default("product")
  productName String
  quantity    Int
  unitPrice   Int
  totalPrice  Int
  metadata    Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order Order @relation("OrderItems", fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("OrderItems")
}

model UserIdentityDocument {
  id              String    @id @default(uuid())
  userId          String    @unique
  documentType    String    @default("cccd") // cccd, driver_license, passport
  frontImageUrl   String
  backImageUrl    String?
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  idCardNumber    String?
  fullName        String?
  reviewedAt      DateTime?
  reviewedBy      String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("UserIdentityDocuments")
}

model UserIdentityHistory {
  id              String    @id @default(uuid())
  userId          String
  documentType    String    @default("cccd") // cccd, driver_license, passport
  frontImageUrl   String
  backImageUrl    String?
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  idCardNumber    String?
  fullName        String?
  reviewedAt      DateTime?
  reviewedBy      String?
  createdAt       DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("UserIdentityHistories")
}

model UserSignature {
  id           String @id @default(uuid())
  userId       String @unique
  signatureUrl String

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("UserSignatures")
}

model BusinessProfile {
  id           String @id @default(uuid())
  userId       String
  fullName     String
  referralCode String
  rank         String
  phone        String?
  gender       String?
  dob          DateTime?
  avatarUrl    String?
  verified     Boolean  @default(false)
  metadata     Json?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@unique(fields: [userId])
  @@unique(fields: [referralCode])
  @@index(fields: [rank, verified])
  @@map("BusinessProfiles")
}

model CultivationCareLog {
  id          String @id @default(uuid())
  code        String
  bedCode     String?
  treeCode    String?
  action      String
  title       String
  description String?
  status      String
  images      String[] @default([])
  loggedAt    DateTime @default(now())

  createdAt   DateTime @default(now())
  createdBy   String?
  updatedAt   DateTime @updatedAt

  @@unique(fields: [code])
  @@index(fields: [bedCode, loggedAt(sort: Desc)])
  @@index(fields: [treeCode, loggedAt(sort: Desc)])
  @@map("CultivationCareLogs")
}

model GardenBooking {
  id           String @id @default(uuid())
  code         String
  userId       String
  gardenCode   String
  visitDate    DateTime
  guestCount   Int
  contactPhone String
  status       String
  adminNote    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique(fields: [code])
  @@index(fields: [userId, status])
  @@map("GardenBookings")
}

model EContract {
  id             String          @id @default(uuid())
  code           String
  userId         String
  orderId        String?         @unique
  treeCode       String?
  title          String
  content        String
  status         String
  signedAt       DateTime?
  expiredAt      DateTime
  signatureUrl   String?
  contractValue  Int             @default(0)
  paymentStatus  String          @default("unpaid")
  isReminderSent Boolean         @default(false)
  reminderSentAt DateTime?
  metadata       Json?
  contractType   String          @default("purchase")
  partyA         String          @default("Sâm Ngọc Linh Farm")
  partyB         String?
  pdfUrl         String?
  terms          String?

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  order        Order?              @relation("OrderContract", fields: [orderId], references: [id], onDelete: SetNull)
  items        EContractItem[]     @relation("ContractItems")
  amendments   ContractAmendment[] @relation("ContractAmendments")

  @@unique(fields: [code])
  @@index(fields: [userId, status])
  @@map("EContracts")
}

model EContractItem {
  id            String   @id @default(uuid())
  contractId    String
  treeId        String
  treeCode      String
  treeName      String
  ageYearAtSign Int
  gardenCode    String?
  bedCode       String?
  unitPrice     Int      @default(0)
  createdAt     DateTime @default(now())

  contract      EContract       @relation("ContractItems", fields: [contractId], references: [id], onDelete: Cascade)
  tree          CultivationTree @relation("TreeContractItems", fields: [treeId], references: [id], onDelete: Restrict)

  @@unique(fields: [contractId, treeId])
  @@index(fields: [contractId])
  @@index(fields: [treeId])
  @@index(fields: [treeCode])
  @@map("EContractItems")
}

model ContractAmendment {
  id                String    @id @default(uuid())
  contractId        String
  amendmentNumber   Int
  code              String    @unique
  type              String    @default("extension") // extension, terms_change, tree_relocation
  title             String
  content           String
  
  previousExpiredAt DateTime
  newExpiredAt      DateTime
  extendedMonths    Int
  amendmentValue    Int       @default(0)
  
  status            String    @default("pending") // pending, signed, cancelled
  signedAt          DateTime?
  signatureUrl      String?
  pdfUrl            String?
  documentHash      String?
  metadata          Json?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  contract          EContract @relation("ContractAmendments", fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, amendmentNumber])
  @@index([contractId, status])
  @@map("ContractAmendments")
}

model CarePackage {
  id             String @id @default(uuid())
  code           String
  name           String
  price          Int
  description    String?
  durationMonths Int
  status         String   @default("active")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique(fields: [code])
  @@map("CarePackages")
}

model ProtectionPackage {
  id             String @id @default(uuid())
  code           String
  name           String
  price          Int
  description    String?
  coverage       String?
  status         String   @default("active")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique(fields: [code])
  @@map("ProtectionPackages")
}












