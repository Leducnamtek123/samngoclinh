APP_NAME="Sâm Ngọc Linh"
APP_ENV=local
APP_LANGUAGE=vi
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_ENCRYPTION_SECRET_KEY=
# URL web app (Next.js) - dùng cho mã QR truy xuất nguồn gốc và redirect kết quả thanh toán
APP_WEB_URL=http://localhost:3002

HOME_URL=https://example.com
HOME_NAME=vismarttech

EMAIL_NO_REPLY=noreply@mail.com
EMAIL_SUPPORT=support@mail.com
EMAIL_ADMIN=admin@mail.com

HTTP_HOST=localhost
HTTP_PORT=3000

LOGGER_ENABLE=true
LOGGER_LEVEL=debug
LOGGER_INTO_FILE=true
LOGGER_PRETTIER=true
LOGGER_AUTO=false

CORS_ALLOWED_ORIGIN=*

URL_VERSIONING_ENABLE=true
URL_VERSION=1

DATABASE_URL=postgresql://postgres:postgres123@localhost:5435/vismarttech?schema=public
DATABASE_DEBUG=true

AUTH_JWT_ISSUER=https://example.com
AUTH_JWT_AUDIENCE=vismarttech

AUTH_JWT_ACCESS_TOKEN_JWKS_URI=http://localhost:3011/.well-known/access-jwks.json
AUTH_JWT_ACCESS_TOKEN_KID=
AUTH_JWT_ACCESS_TOKEN_PRIVATE_KEY=
AUTH_JWT_ACCESS_TOKEN_PUBLIC_KEY=
AUTH_JWT_ACCESS_TOKEN_EXPIRED=1h

AUTH_JWT_REFRESH_TOKEN_JWKS_URI=http://localhost:3011/.well-known/refresh-jwks.json
AUTH_JWT_REFRESH_TOKEN_KID=
AUTH_JWT_REFRESH_TOKEN_PRIVATE_KEY=
AUTH_JWT_REFRESH_TOKEN_PUBLIC_KEY=
AUTH_JWT_REFRESH_TOKEN_EXPIRED=30d

AUTH_TWO_FACTOR_ISSUER=
AUTH_TWO_FACTOR_ENCRYPTION_KEY=

AUTH_SOCIAL_GOOGLE_CLIENT_ID=
AUTH_SOCIAL_GOOGLE_CLIENT_SECRET=

AUTH_SOCIAL_APPLE_CLIENT_ID=
AUTH_SOCIAL_APPLE_SIGN_IN_CLIENT_ID=


SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

CACHE_REDIS_URL=redis://localhost:6379/0

QUEUE_REDIS_URL=redis://localhost:6379/1

SENTRY_DSN=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# =========================================================================
# FILE STORAGE DRIVER ARCHITECTURE
# Options: local (Mặc định - lưu ổ cứng /uploads) | s3 | minio | cloudinary | gcs
# =========================================================================
STORAGE_DRIVER=local

# [Tùy chọn mở rộng trong tương lai khi cắm thêm Cloud Storage Provider]:
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

SEPAY_BANK_BRAND=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=
# Cổng thanh toán SePay (pay.sepay.vn) - lấy trong dashboard SePay; SEPAY_PG_ENV: sandbox | production
SEPAY_PG_ENV=sandbox
SEPAY_PG_MERCHANT_ID=
SEPAY_PG_SECRET_KEY=

PAYMENT_WEBHOOK_SECRET=